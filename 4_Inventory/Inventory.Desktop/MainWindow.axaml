<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:logic="using:Inventory.Logic"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Inventory.Desktop.MainWindow"
        Title="Inventory.Desktop">
    <StackPanel Margin="20">
        <TextBox Name="ItemNameInput" Watermark="Item Name" />
        <TextBox Name="QuantityInput" Watermark="Quantity" />
        <Button Name="AddBtn" Content="Add Item" Click="AddBtn_Click" />
        <ListBox Name="InventoryList">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="logic:Item">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}"/>
                            <TextBlock Text="{Binding StockStatus}" Foreground="{Binding StockStatusColor}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#2e2323" CornerRadius="5" Padding="10,5">
                            <TextBlock Text="{Binding Quantity}" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</Window>
